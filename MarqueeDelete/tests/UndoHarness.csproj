<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><Nullable>disable</Nullable><EnableDefaultCompileItems>false</EnableDefaultCompileItems><UseAppHost>false</UseAppHost><NoWarn>CS0169;CS0414;CS0649;CS0436</NoWarn></PropertyGroup>
  <PropertyGroup>
    <!-- The two math assemblies are pure managed code and load outside the player; everything else
         Unity-side is shimmed for that reason. Override GameManagedDir for a different install. -->
    <GameManagedDir Condition="'$(GameManagedDir)' == ''">D:\steam\steamapps\common\Cities Skylines II\Cities2_Data\Managed</GameManagedDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="harness/Shim.cs" Link="Shim.cs"/>
    <Compile Include="harness/Components.cs" Link="Components.cs"/>
    <Compile Include="harness/Program.cs" Link="Program.cs"/>
    <Compile Include="../Cascade.cs" Link="Cascade.cs"/>
    <Compile Include="../DeletionPolicies.cs" Link="DeletionPolicies.cs"/>
    <Compile Include="../Compatibility.cs" Link="Compatibility.cs"/>
    <Compile Include="../DeletionUndo.cs" Link="DeletionUndo.cs"/>
    <Compile Include="../SelectiveUndoLogic.cs" Link="SelectiveUndoLogic.cs"/>
    <Compile Include="../UndoBatchPolicy.cs" Link="UndoBatchPolicy.cs"/>
    <Compile Include="../SelectionLogic.cs" Link="SelectionLogic.cs"/>
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Unity.Mathematics"><HintPath>$(GameManagedDir)\Unity.Mathematics.dll</HintPath></Reference>
    <Reference Include="Colossal.Mathematics"><HintPath>$(GameManagedDir)\Colossal.Mathematics.dll</HintPath></Reference>
  </ItemGroup>
</Project>
